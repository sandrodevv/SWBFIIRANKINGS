# Service account JSON with Analytics Viewer access, as a single-line string.
# Create in Google Cloud, enable "Google Analytics Data API", then add the
# service account email as a Viewer on the GA4 property.
GA4_CREDENTIALS_JSON=
# Optional alternative to GA4_CREDENTIALS_JSON: path to the credentials JSON file.
